# Firebase web config for Homemade Uno.
#
# A Firebase *web* config is not a secret — hidden hands are enforced by
# Firestore Security Rules + Cloud Functions, not by hiding these values. Do
# NOT put service-account keys or any real secret here.
#
# Copy this file to `.env.local` (git-ignored) and fill in the values from your
# Firebase project's web-app config to run against a real project.

# --- Real project (production / staging) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local development against the Emulator Suite ---
# `vite dev` (import.meta.env.DEV) already routes to emulators automatically.
# Set this to "true" to force emulators from a production-like build too.
# When using emulators the VITE_FIREBASE_* values above are optional — a demo
# project id (demo-homemade-uno, see .firebaserc) is enough.
VITE_USE_EMULATOR=true

# Emulator host (defaults to 127.0.0.1 when unset).
VITE_EMULATOR_HOST=127.0.0.1
