# Supabase config for Homemade Uno.
#
# Both values are public by design: hidden hands are enforced by Row Level
# Security + the `game` Edge Function, not by hiding these. Never put the
# service-role / secret key here.
#
# Copy to `.env.local` (git-ignored).

# --- Production: Supabase dashboard → Project Settings → API ---
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# --- Local development: `supabase start`, then `supabase status` ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status -o env`>
